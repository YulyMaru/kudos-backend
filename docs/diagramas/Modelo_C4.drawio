        <mxCell id="SMVH53LDstS-y8KTIakh-6" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#2B6FBF;strokeColor=#1A4F8F;fontColor=#ffffff;align=center;metaEdit=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Aplicación web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Angular + TypeScript · PWA]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Interfaz Mobile First: feed, publicar Kudo con adjuntos, notificaciones en tiempo real y administración. Alojada en Firebase Hosting.&lt;/span&gt;" vertex="1">
