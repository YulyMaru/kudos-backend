        </mxCell>
        <mxCell id="SMVH53LDstS-y8KTIakh-7" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#2B6FBF;strokeColor=#1A4F8F;fontColor=#ffffff;align=center;metaEdit=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;API Backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Spring Boot 4.1 + Java 25]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Puertos y Adaptadores en Google Cloud Run. API REST con JWT, canal WebSocket/STOMP, outbox de notificaciones con reintentos y auditoría.&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="300" x="853" y="900" as="geometry" />
        </mxCell>
        <mxCell id="SMVH53LDstS-y8KTIakh-8" parent="1" style="shape=cylinder3;size=15;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#2B6FBF;strokeColor=#1A4F8F;fontColor=#ffffff;align=center;metaEdit=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: PostgreSQL · Supabase]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Usuarios, estructura organizacional, Kudos, réplicas, calificaciones, outbox y auditoría de solo inserción. Copias de seguridad automáticas.&lt;/span&gt;" vertex="1">
          <mxGeometry height="180" width="260" x="1333" y="885" as="geometry" />
        </mxCell>
        <mxCell id="SMVH53LDstS-y8KTIakh-9" parent="1" style="shape=cylinder3;size=15;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#2B6FBF;strokeColor=#1A4F8F;fontColor=#ffffff;align=center;metaEdit=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Almacenamiento de adjuntos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Supabase Storage · API S3]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Bucket privado con los archivos de los Kudos. Descarga solo con URL firmadas de corta duración.&lt;/span&gt;" vertex="1">
          <mxGeometry height="180" width="280" x="313" y="1175" as="geometry" />
