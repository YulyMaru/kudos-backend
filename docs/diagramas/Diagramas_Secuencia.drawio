y"><mxPoint x="150.0" y="219" as="sourcePoint"/><mxPoint x="330.0" y="219" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4838_30" value="2. SELECT notificaciones&lt;br&gt;PENDIENTES o a reintentar …&lt;br&gt;FOR UPDATE SKIP LOCKED" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="276" as="sourcePoint"/><mxPoint x="510.0" y="276" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4838_31" value="3. Lote de notificaciones" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510.0" y="307" as="sourcePoint"/><mxPoint x="330.0" y="307" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4838_32" value="4. Envía correo «Te reconocieron en UCO Kudos» (SMTP/TLS)" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="398" as="sourcePoint"/><mxPoint x="690.0" y="398" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4838_33" value="5. Aceptado" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690.0" y="429" as="sourcePoint"/><mxPoint x="330.0" y="429" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4838_34" value="6. Paso 2: correo electrónico" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690.0" y="460" as="sourcePoint"/><mxPoint x="1230.0" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4838_35" value="7. Envía planti