 x="143.0" y="536" width="500" height="18" as="geometry"/></mxCell><mxCell id="p3341_12" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="85.0" y="1004" as="sourcePoint"/><mxPoint x="1175.0" y="1004" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3341_13" value="&lt;i&gt;[datos inválidos]&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="93.0" y="1006" width="500" height="18" as="geometry"/></mxCell><mxCell id="p3341_14" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=50;height=20;fillColor=none;strokeColor=#555555;fontStyle=1;fontSize=11;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="663.0" y="564" width="314.0" height="200" as="geometry"/></mxCell><mxCell id="p3341_15" value="&lt;i&gt;[por cada adjunto]&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="721.0" y="566" width="500" height="18" as="geometry"/></mxCell><mxCell id="p3341_16" value="1. Elige destinatario y&lt;br&gt;categoría, escribe el&lt;br&gt;contenido, adjunta archivos y&lt;br&gt;publica" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="155.0" y="228" as="sourcePoint"/><mxPoint x="345.0" y="228" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3341_17" value="2. POST /api/v1/kudos (multipart&lt;br&gt;+ JWT)" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="345.0" y="272" as="sourcePoint"/><mxPoint x="535.0" y="272" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3341_18" value="3. Valida JWT y formato de&lt;br&gt;la solicitud" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;endArrow=block;endFill=1;align=left;spacingLeft=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="535.0" y="316" as="sourcePoint"/><mxPoint x="535.0" y="338" as="targetPoint"/><Array as="points"><mxPoint x="575.0" y="316"/><mxPoint x="575.0" y="338"/></Array></mxGeometry></mxCell><mxCell id="p3341_19" value="4. publicar(comando)" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="535.0" y="375" as="sourcePoint"/><mxPoint x="725.0" y="375" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3341_20" value="5. Consulta destinatario y categoría" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725.0" y="406" as="sourcePoint"/><mxPoint x="1105.0" y="406" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3341_21" value="6. Destinatario activo, categoría activa" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1105.0" y="437" as="sourcePoint"/><mxPoint x="725.0" y="437" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3341_22" value="7. Aplica reglas de negocio&lt;br&gt;(no auto-reconocimiento,&lt;br&gt;campos obligatorios)" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;endArrow=block;endFill=1;align=left;spacingLeft=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725.0" y="494" as="sourcePoint"/><mxPoint x="725.0" y="516" as="targetPoint"/><Array as="points"><mxPoint x="765.0" y="494"/><mxPoint x="765.0" y="516"/></Array></mxGeometry></mxCell><mxCell id="p3341_23" value="8. Valida tipo por contenido&lt;br&gt;y tamaño; calcula hash&lt;br&gt;SHA-256" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;endArrow=block;endFill=1;align=left;spacingLeft=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725.0" y="639" as="sourcePoint"/><mxPoint x="725.0" y="661" as="targetPoint"/><Array as="points"><mxPoint x="765.0" y="639"/><mxPoint x="765.0" y="661"/></Array></mxGeometry></mxCell><mxCell id="p3341_24" value="9. Sube el archivo al bucket&lt;br&gt;privado (API S3)" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725.0" y="711" as="sourcePoint"/><mxPoint x="915.0" y="711" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3341_25" value="10. Clave del objeto" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915.0" y="742" as="sourcePoint"/><mxPoint x="725.0" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3341_26" value="Paso 1 del flujo obligatorio: una sola transacción&lt;br&gt;(todo o nada)" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF2CC;strokeColor=#B59F3B;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="665.0" y="782" width="500.0" height="38" as="geometry"/></mxCell><mxCell id="p3341_27" value="11. BEGIN · INSERT kudo y adjuntos · INSERT outbox ×3 (EMAIL,&lt;br&gt;WHATSAPP, PUSH) · INSERT auditoría KUDO_PUBLICADO · COMMIT" style="html=1;verticalAlign=bottom;fontSize=10;strokeColor=#333333;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725.0" y="860" as="sourcePoint"/><mxPoint x="1105.0" y="860" as="targetPoint"/></mxGeome